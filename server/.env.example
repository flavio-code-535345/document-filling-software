# Server configuration
PORT=4000

# Public URL of the web app as reachable from a phone on your network.
# Leave empty to auto-derive from the incoming request Host header.
# Example: PUBLIC_WEB_URL=http://192.168.1.20:5173
PUBLIC_WEB_URL=

# Signature session lifetime (minutes)
SIGN_SESSION_TTL_MINUTES=10

# Max upload size (MB)
MAX_UPLOAD_MB=25

# --- Optional: AI field auto-detection (falls back to AcroForm detection when unset) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional: email dispatch (SMTP). Jobs can email generated PDFs when configured. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: webhook called after a job finishes (POST with job manifest JSON)
DISPATCH_WEBHOOK_URL=
