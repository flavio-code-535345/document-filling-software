# Secret used to sign session cookies (min. 32 chars). Fail loudly if unset.
AUTH_SECRET=

# Set to "true" behind HTTPS to mark session cookies `secure`.
COOKIE_SECURE=false

# Where the JSON store and uploaded template PDFs live. Defaults to ./data
DATA_DIR=./data

# Optional: AI provider keys for field detection ("KI-Scan").
# Can also be configured per-UI under Einstellungen → KI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Lokale Felderkennung über Ollama (Vision-Modell, kein Cloud-AI).
# Läuft Ollama im Sidecar-Container, bleibt "http://ollama:11434".
# Läuft Ollama auf dem Host, "http://host.docker.internal:11434".
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5-vl:7b
